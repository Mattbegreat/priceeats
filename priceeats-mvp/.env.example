# ---- 資料來源 ----
# 兩個都留空 = 使用內建模擬資料 (MockRepository)。
# 兩個都填 = 啟用 SupabaseRepository (anon key 受 RLS 限制，可公開在前端)。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 第二階段 (本階段程式不會讀取，僅預留) ----
# Google Places：只能放在伺服器端環境變數，不可加 NEXT_PUBLIC_ 前綴。
GOOGLE_PLACES_API_KEY=
# 菜單 OCR (例如 Gemini 免費額度)：同樣只放伺服器端。
GEMINI_API_KEY=

# ---- 建置旗標 (由 npm run build:demo 自動設定，一般不需手動填) ----
# BUILD_DEMO=1
# NEXT_PUBLIC_DEMO=1
